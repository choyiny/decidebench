# API keys for re-running entries. Prices are declared in each adapter, not here.
# Together-hosted references
TOGETHER_API_KEY=

# JEV: AI Space
AISPACE_API_KEY=
JEV_BASE_URL=https://ai.xyspace.dev/v1
JEV_MODEL=jev-latest

# Recorded in results/<version>/meta/<entry>.json, e.g. "us-east (Toronto, residential)"
DECIDEBENCH_CLIENT_REGION=

# Self-hosted entries (TEV, CLM, Laya, Decider-2B, Kev-4B, Qwen3-8B, gpt-oss-120b, Llama-3.3-70B) run on a CUDA
# machine reached over SSH, as <user>@<host>; see tools/selfhosted/README.md. Their server URLs default to
# 127.0.0.1 on that machine.
GPU_SSH=
